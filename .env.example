# ContentMultiplier Environment Configuration
# Copy this file to .env and fill in your values
#
# For Railway deployment: Add these as environment variables in the Railway dashboard
# Go to: Your Project > Variables > Add Variable

# ===========================================
# REQUIRED API KEYS
# ===========================================

# Anthropic API Key (for Claude Opus 4.5 - drafting)
# Get from: https://console.anthropic.com/
# NOTE: You can use EITHER Anthropic OR OpenRouter for Claude models
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter API Key (ALTERNATIVE to Anthropic)
# Get from: https://openrouter.ai/
# If you set this and leave ANTHROPIC_API_KEY empty, OpenRouter will be used automatically
OPENROUTER_API_KEY=your_openrouter_key_here

# Set to true to force OpenRouter even if Anthropic key is set
USE_OPENROUTER=false

# Google AI Studio API Key (for Gemini models)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_key_here

# ===========================================
# SECURITY
# ===========================================

# Secret key for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Use a strong, unique key in production!
SECRET_KEY=your_secret_key_here_change_in_production

# ===========================================
# DATABASE
# ===========================================

# Database path (SQLite with async support)
# For Railway with volume: The app auto-detects RAILWAY_VOLUME_MOUNT_PATH
DATABASE_URL=sqlite+aiosqlite:///./database/contentmultiplier.db

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Debug mode (set to false in production)
DEBUG=true

# Maximum upload file size in MB
UPLOAD_MAX_SIZE_MB=500

# Environment mode: development or production
ENVIRONMENT=development

# Port (Railway sets this automatically via PORT env var)
# PORT=8000

# ===========================================
# ADMIN CREDENTIALS
# ===========================================

# Admin dashboard access - CHANGE THESE IN PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_change_this

# ===========================================
# CORS SETTINGS
# ===========================================

# Comma-separated list of allowed origins for CORS
# For Railway: Add your Railway domain (e.g., https://your-app.up.railway.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000

# ===========================================
# RATE LIMITING (OPTIONAL)
# ===========================================

# Maximum uploads per user per hour (default: 10)
# RATE_LIMIT_UPLOADS=10

# ===========================================
# RAILWAY-SPECIFIC (auto-set by Railway)
# ===========================================

# RAILWAY_ENVIRONMENT=production
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# RAILWAY_VOLUME_MOUNT_PATH=/data
# PORT=8000

# ===========================================
# REPLIT-SPECIFIC (auto-set by Replit)
# ===========================================

# REPL_SLUG=
# REPL_OWNER=
# REPL_ID=
